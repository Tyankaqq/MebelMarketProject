<Window x:Class="ToysMarkerProject.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToysMarkerProject"
        mc:Ignorable="d"
        Title="Товары администратора" Height="450" Width="800">

    <Grid>
        <TextBlock x:Name="RoleNameBox" Text= "{Binding Name}" VerticalAlignment="Top" HorizontalAlignment="Right" Width="100" Margin="0, 10, 0, 0"/>
        <TextBlock Text="Пользователь:" VerticalAlignment="Top" HorizontalAlignment="Right" Width="83" Margin="0,10,250,0" Foreground="Black" RenderTransformOrigin="0.213,0.629"/>
        <TextBlock x:Name="FullNameBox" Text="{Binding Name}" VerticalAlignment="Top" HorizontalAlignment="Right" Width="129" Margin="0,10,121,0"/>
        <Button Content="Заказы" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="31,10,0,0" Click="BtnOrder_Click"/>
        <StackPanel Orientation="Horizontal" Margin="0,35,0,0" VerticalAlignment="Top">
            <TextBox x:Name="SearchTextBox" Width="220" Height="25" Margin="5" TextChanged="SearchTextBox_TextChanged"/>
            <ComboBox x:Name="SortComboBox" Width="180" Height="25" Margin="5" SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="Цена по возрастанию"/>
                <ComboBoxItem Content="Цена по убыванию"/>
                <ComboBoxItem Content="Количество по возрастанию"/>
                <ComboBoxItem Content="Количество по убыванию"/>
            </ComboBox>
            <ComboBox x:Name="DiscountComboBox" Width="150" Height="25" Margin="5" SelectionChanged="DiscountComboBox_SelectionChanged">
                <ComboBoxItem Content="Все диапазоны"/>
                <ComboBoxItem Content="0-10,99%"/>
                <ComboBoxItem Content="11-14,99%"/>
                <ComboBoxItem Content="15% и более"/>
            </ComboBox>
            <Button Content="Выйти" Width="80" Height="25" Click="BtnExit_Click"/>
        </StackPanel>
        <ListView x:Name="ProductListView" Margin="0,65,0,55" MouseDoubleClick="ProductListView_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="{Binding RowColor}"/>
                    <Setter Property="Margin" Value="0,2"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="470"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="1" Source="{Binding ImageSource}" Width="96" Height="96" Stretch="UniformToFill"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Category.Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Manufacturer.Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Provider.Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Unit.Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Count, StringFormat=Количество: {0}}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Cost, StringFormat=Цена: {0}}" Foreground="Red" TextDecorations="Strikethrough"/>
                            <TextBlock Text="{Binding DiscountCost, StringFormat=Итог: {0:F2}}"/>
                            <TextBlock Text="{Binding Discount, StringFormat=Скидка: {0}%}"/>
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
        <Button Content="Добавить" VerticalAlignment="Bottom" Width="200" HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnAdd_Click" Style="{StaticResource BlueButton}">

        </Button>
        <Button Content="Редактировать" VerticalAlignment="Bottom" Width="200" HorizontalAlignment="Center" Margin="0,0,0,10" Click="BtnEdit_Click">

        </Button>
        <Button Content="Удалить" VerticalAlignment="Bottom" Width="200" HorizontalAlignment="Right" Margin="0,0,0,10" Click="BtnDelete_Click">

        </Button>
    </Grid>
</Window>
