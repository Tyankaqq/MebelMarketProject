<Window x:Class="ToysMarkerProject.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToysMarkerProject"
        mc:Ignorable="d"
        Title="Заказ" Height="360" Width="600">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ID" Grid.Row="0" Margin="5"/>
        <TextBox x:Name="IdTextBox" Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="True"/>

        <TextBlock Text="Артикул" Grid.Row="1" Margin="5"/>
        <TextBox x:Name="ArticleTextBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Статус" Grid.Row="2" Margin="5"/>
        <ComboBox x:Name="StatusComboBox" Grid.Row="2" Grid.Column="1" Margin="5" IsEditable="True">
            <ComboBoxItem Content="Новый"/>
            <ComboBoxItem Content="В обработке"/>
            <ComboBoxItem Content="Готов к выдаче"/>
            <ComboBoxItem Content="Выдан"/>
            <ComboBoxItem Content="Отменен"/>
        </ComboBox>

        <TextBlock Text="Адрес ПВЗ" Grid.Row="3" Margin="5"/>
        <ComboBox x:Name="AddressComboBox" Grid.Row="3" Grid.Column="1" Margin="5" DisplayMemberPath="Address" SelectedValuePath="Id"/>

        <TextBlock Text="Дата заказа" Grid.Row="4" Margin="5"/>
        <DatePicker x:Name="DateOrderPicker" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Дата выдачи" Grid.Row="5" Margin="5"/>
        <DatePicker x:Name="DateDeliveryPicker" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Код" Grid.Row="6" Margin="5"/>
        <TextBox x:Name="CodeTextBox" Grid.Row="6" Grid.Column="1" Margin="5"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Сохранить" Width="120" Height="30" Click="BtnSave_Click" Style="{StaticResource BlueButton}"/>
            <Button Content="Отмена" Width="120" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
