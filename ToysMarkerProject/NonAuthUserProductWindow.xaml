<Window x:Class="ToysMarkerProject.NonAuthUserProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToysMarkerProject"
        mc:Ignorable="d"
        Title="Товары гостя" Height="450" Width="800">
    <Grid>

        <TextBlock Text="Пользователь: Гость" VerticalAlignment="Top" HorizontalAlignment="Right" Width="115" Margin="0,10,218,0" Foreground="Black" RenderTransformOrigin="0.213,0.629"/>
        <Button Content="Выйти" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="31,10,0,0" Click="BtnExit_Click"/>

        <ListView x:Name="ProductListView" Margin="0,31,0,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="{Binding RowColor}"/>
                    <Setter Property="Margin" Value="0,2"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="1" Source="{Binding ImageSource}" Width="96" Height="96" Stretch="UniformToFill"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Category.Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Manufacturer.Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Provider.Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Unit.Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Count, StringFormat=Количество: {0}}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Cost, StringFormat=Цена: {0}}" Foreground="Red" TextDecorations="Strikethrough"/>
                            <TextBlock Text="{Binding DiscountCost, StringFormat=Итог: {0:F2}}"/>
                            <TextBlock Text="{Binding Discount, StringFormat=Скидка: {0}%}"/>
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>
</Window>
